---
import Metin from '../../duzen/Metin.astro'
import HukukiBolumler from '../../ortak/HukukiBolumler.astro'
import { dilYollari, type Dil } from '../../i18n/diller'
import { sozluk } from '../../i18n/sozlukler'
import { gizlilikBolumleri } from '../../hukuki/index'

// GIZLILIK METNI - uygulamayla ORTAK kaynaktan, yedi dilde.
// Turkce metin esastir; diger dillerde Metin bileseni basa notu koyar.
export function getStaticPaths() {
  return dilYollari()
}

const { dil } = Astro.props as { dil: Dil }
const t = sozluk(dil).gizlilik
---

<Metin
  baslik={t.baslik}
  aciklama={t.aciklama}
  guncelleme={new Date(2026, 8, 13)}
  dil={dil}
  yol="/gizlilik"
  hukuki
>
  <HukukiBolumler bolumler={gizlilikBolumleri(dil)} />
</Metin>
