---
import Metin from '../../duzen/Metin.astro'
import { dilYollari, dilOneki, type Dil } from '../../i18n/diller'
import { sozluk } from '../../i18n/sozlukler'

export function getStaticPaths() {
  return dilYollari()
}

const { dil } = Astro.props as { dil: Dil }
const t = sozluk(dil).destek
const onek = dilOneki(dil)
const EPOSTA = 'destek@slooin.com'

/** `{{eposta}}` ve `{{hesapSil}}` yer tutucularini parcalara ayirir. */
function parcala(metin: string) {
  return metin.split(/(\{\{eposta\}\}|\{\{hesapSil\}\})/g).filter(Boolean)
}
---

<Metin
  baslik={t.baslik}
  aciklama={t.aciklama}
  guncelleme={new Date(2026, 8, 13)}
  dil={dil}
  yol="/destek"
>
  <p>
    {parcala(t.giris).map((p) => (p === '{{eposta}}' ? <a href={`mailto:${EPOSTA}`}>{EPOSTA}</a> : p))}
  </p>

  <h2>{t.sssBaslik}</h2>

  {
    t.sss.map((madde) => (
      <>
        <h3>{madde.soru}</h3>
        <p>
          {parcala(madde.cevap).map((p) =>
            p === '{{hesapSil}}' ? (
              <a href={`${onek}/hesap-sil`}>{t.hesapSilBaglanti}</a>
            ) : p === '{{eposta}}' ? (
              <a href={`mailto:${EPOSTA}`}>{EPOSTA}</a>
            ) : (
              p
            )
          )}
        </p>
      </>
    ))
  }
</Metin>
