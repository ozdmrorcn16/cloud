---
import Duzen from '../../duzen/Duzen.astro'
import AltSerit from '../../duzen/AltSerit.astro'
import MarkaLockup from '../../ortak/MarkaLockup.astro'
import Telefon from '../../ortak/Telefon.astro'
import { dilYollari, type Dil } from '../../i18n/diller'
import { tr } from '../../i18n/tr'

export function getStaticPaths() {
  return dilYollari()
}

const { dil } = Astro.props as { dil: Dil }
// Kabuk metni bugun yalniz Turkce; sonradan dil eklenince burada
// AltSerit'teki gibi bir dil->sozluk haritasi kurulur.
const t = tr
---

<Duzen
  baslik="Slooin"
  aciklama="Slooin, aynı anda aynı yerde olan insanların birbirini fark etmesini sağlayan konum tabanlı bir tanışma uygulamasıdır."
  dil={dil}
  yol=""
>
  <header class="kahraman">
    <span class="dalga" aria-hidden="true"></span>
    <img class="filigran" src="/marka-isareti.png" alt="" aria-hidden="true" />

    <div class="ust">
      <a class="giris" href="https://slooin.expo.app">{t.girisDugmesi}</a>
    </div>

    <div class="govde">
      <div class="sol">
        <MarkaLockup />

        <div class="rozetler">
          <span class="rozet">
            <svg viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M16.4 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.7.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.5 0-2.8.8-3.6 2.1-1.5 2.6-.4 6.5 1.1 8.7.7 1 1.6 2.2 2.7 2.2 1.1 0 1.5-.7 2.8-.7 1.3 0 1.6.7 2.8.7 1.2 0 1.9-1 2.6-2 .8-1.2 1.2-2.3 1.2-2.4-.1 0-2.2-.9-2.2-3.5zM14.2 5.9c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.7-.9 2.6 1 .1 2-.5 2.6-1.2z"/></svg>
            <span class="yazi"><span class="ust-yazi">Yakında</span><span class="alt-yazi">App Store'da</span></span>
          </span>
          <span class="rozet">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M4.6 2.3 14 11.7l-2.4 2.4L4 6.5V3.7c0-.6.2-1.1.6-1.4z"/><path fill="#FBBC04" d="M17.6 9.3 14 11.7l2.4 2.4 3.4-1.9c.9-.5.9-1.8 0-2.3l-2.2-1.2z"/><path fill="#EA4335" d="M4.6 2.3 16.4 9l-2.4 2.7L4.6 2.3z"/><path fill="#4285F4" d="M4.6 21.1 14 11.7l2.4 2.4L4.6 21.1z"/></svg>
            <span class="yazi"><span class="ust-yazi">Yakında</span><span class="alt-yazi">Google Play'de</span></span>
          </span>
        </div>

        <div class="slogan-satir">
          <p class="slogan">Aynı yerdesiniz.<br />Birbirinizi fark edin.</p>
          <img class="isaret" src="/marka-isareti.png" alt="" aria-hidden="true" />
        </div>
      </div>

      <div class="telefonlar">
        <Telefon konum="arka" gorsel="/ekran-mekan.png" alt="Slooin mekan sayfası" />
        <Telefon konum="on" gorsel="/ekran-kesfet.png" alt="Slooin check-in ekranı" />
      </div>
    </div>
  </header>

  <AltSerit dil={dil} yol="" />
</Duzen>

<style>
  /* =========================================================
     KAHRAMAN — maketten (tasarim/site-ana-sayfa-maketi.html) BIREBIR
     tasindi; olculer degistirilmedi.
     ========================================================= */

  .kahraman {
    position: relative;
    overflow: hidden;
    background: linear-gradient(168deg, var(--turuncu-acik) 0%, var(--turuncu) 46%, var(--turuncu-koyu) 100%);
    color: var(--beyaz);
    padding: 22px 28px 40px;
    min-height: min(820px, max(680px, 100vh - 96px));
    display: flex;
    flex-direction: column;
  }

  /* Swarm'daki dalga: zeminin uzerinden gecen cok hafif acik bant */
  .kahraman .dalga {
    position: absolute;
    left: -8%;
    right: -8%;
    top: 44%;
    height: 340px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50% 50% 0 0 / 110px 110px 0 0;
    transform: rotate(-3deg);
    pointer-events: none;
  }

  .ust {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
  }

  .giris {
    font-size: 14px;
    font-weight: 600;
    color: var(--beyaz);
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    padding: 8px 24px;
    background: transparent;
  }

  .giris:hover { background: rgba(255, 255, 255, 0.14); }
  .giris:focus-visible { outline: 3px solid var(--beyaz); outline-offset: 3px; }

  .govde {
    position: relative;
    z-index: 1;
    flex: 1;
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .govde { grid-template-columns: minmax(300px, 0.86fr) minmax(0, 1.14fr); gap: 26px; }
  }

  /* ---- sol blok ---- */

  .sol { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }

  @media (max-width: 899px) { .sol { align-items: center; text-align: center; } }

  .rozetler { display: flex; flex-direction: column; gap: 11px; align-items: inherit; }

  .rozet {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: #111014;
    color: var(--beyaz);
    border-radius: 9px;
    padding: 9px 18px 9px 15px;
    min-width: 214px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .rozet svg { width: 22px; height: 22px; flex: none; }
  .rozet .yazi { display: flex; flex-direction: column; line-height: 1.15; text-align: left; }
  .rozet .ust-yazi { font-size: 9.5px; letter-spacing: 0.07em; text-transform: uppercase; color: #BDB8B2; }
  .rozet .alt-yazi { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }

  .slogan-satir {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 2px;
  }

  @media (max-width: 899px) { .slogan-satir { justify-content: center; } }

  .slogan {
    font-size: clamp(17px, 2.1vw, 21px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    text-wrap: balance;
  }

  .isaret { width: 54px; height: 54px; flex: none; display: block; }

  /* ---- sag: telefonlar ---- */

  .telefonlar {
    position: relative;
    height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 899px) { .telefonlar { height: 460px; } }

  /* ---- logo filigrani ---- */

  .filigran {
    position: absolute;
    left: -7%;
    bottom: -16%;
    width: clamp(300px, 40vw, 580px);
    opacity: 0.085;
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 899px) {
    .filigran { left: auto; right: -18%; bottom: auto; top: -8%; width: 320px; }
  }
</style>
