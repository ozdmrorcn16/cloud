---
import Metin from '../../duzen/Metin.astro'
import { dilYollari, type Dil } from '../../i18n/diller'
import { sozluk } from '../../i18n/sozlukler'

export function getStaticPaths() {
  return dilYollari()
}

const { dil } = Astro.props as { dil: Dil }
const t = sozluk(dil).hesapSil
const EPOSTA = 'destek@slooin.com'
const dipnot = t.dipnot.split(/(\{\{eposta\}\})/g).filter(Boolean)
---

<Metin
  baslik={t.baslik}
  aciklama={t.aciklama}
  guncelleme={new Date(2026, 8, 13)}
  dil={dil}
  yol="/hesap-sil"
>
  <p>{t.giris}</p>

  <h2>{t.neSilinirBaslik}</h2>
  <ul>
    {t.silinenler.map((madde) => <li>{madde}</li>)}
  </ul>

  <h2>{t.neKalirBaslik}</h2>
  <p>{t.neKalir}</p>

  <p class="kutu">{t.uyari}</p>

  <h2>{t.silBaslik}</h2>
  <p>{t.silAciklama}</p>

  <form id="silme-formu">
    <label>
      {t.epostaEtiket}
      <input type="email" name="eposta" autocomplete="email" required />
    </label>
    <button id="kod-dugmesi" type="button">{t.kodGonder}</button>
    <div id="kod-alani" hidden>
      <label>
        {t.kodEtiket}
        <input type="text" name="kod" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" />
      </label>
      <button id="sil-dugmesi" type="submit">{t.dugme}</button>
    </div>
  </form>

  <p id="durum" class="durum" role="status" aria-live="polite"></p>

  <p>
    {dipnot.map((parca) => (parca === '{{eposta}}' ? <a href={`mailto:${EPOSTA}`}>{EPOSTA}</a> : parca))}
  </p>
</Metin>

<script>
  import '../../betik/hesap-sil.ts'
</script>

<style>
  form, #kod-alani { display: flex; flex-direction: column; gap: 14px; margin: 18px 0 10px; max-width: 380px; }
  #kod-alani[hidden] { display: none; }
  #kod-alani { margin: 0; }

  label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; }

  input {
    font: inherit;
    font-weight: 400;
    padding: 10px 12px;
    border: 1px solid var(--cizgi);
    border-radius: 10px;
    background: var(--beyaz);
    color: var(--metin);
  }

  input:focus-visible { outline: 2px solid var(--turuncu); outline-offset: 1px; }

  #kod-dugmesi {
    font: inherit;
    font-weight: 600;
    padding: 12px 18px;
    border: 1.5px solid var(--turuncu);
    border-radius: 10px;
    background: var(--beyaz);
    color: var(--turuncu);
    cursor: pointer;
  }

  #sil-dugmesi {
    font: inherit;
    font-weight: 600;
    padding: 12px 18px;
    border: 0;
    border-radius: 10px;
    background: #c0392b;
    color: var(--beyaz);
    cursor: pointer;
  }

  button:disabled { opacity: 0.6; cursor: default; }
  button:focus-visible { outline: 3px solid var(--metin); outline-offset: 2px; }

  .durum { font-size: 15px; margin: 6px 0 0; min-height: 1.5em; }
  .durum.hata { color: #c0392b; }
  .durum.bilgi { color: var(--ikincil); }
  .durum.basari { color: #1f7a4d; font-weight: 600; }
</style>
