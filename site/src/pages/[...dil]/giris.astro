---
/**
 * GIRIS SAYFASI - kullanicinin referansi Swarm'in web giris sayfasi
 * (swarmapp.com/login, 2026-09-14): ustte marka bandi + magaza
 * rozetleri, ortada tek kart (e-posta, sifre, "Sifreni mi unuttun?",
 * "Giris yap"), altta serit.
 *
 * Giris SUPABASE'E dogrudan yapilir (`betik/giris.ts`), basarili olunca
 * oturum uygulamanin web surumune (`slooin.expo.app`) adres cubugunun
 * `#` kismiyla tasinir - iki alan adi farkli oldugu icin oturum baska
 * turlu gecmiyor. Sifre bu sayfadan hicbir yere yazilmaz; Supabase'in
 * kendi istemcisi dogrudan konusuyor.
 *
 * Magaza rozetleri ana sayfadakiyle AYNI ("Yakinda"): uygulama henuz
 * magazada degil, sahte baglanti konmadi.
 */
import Duzen from '../../duzen/Duzen.astro'
import AltSerit from '../../duzen/AltSerit.astro'
import { dilYollari, type Dil } from '../../i18n/diller'
import { sozluk } from '../../i18n/sozlukler'

export function getStaticPaths() {
  return dilYollari()
}

const { dil } = Astro.props as { dil: Dil }
const t = sozluk(dil).giris
const a = sozluk(dil).ana
---

<Duzen baslik={`${t.baslik} · Slooin`} aciklama={t.aciklama} dil={dil} yol="/giris">
  <header class="bant">
    <a class="marka" href={dil === 'tr' ? '/' : `/${dil}/`} aria-label="Slooin">
      <img src="/marka-yazisi-acik.png" alt="Slooin" width="132" height="39" />
    </a>
    <div class="rozetler">
      <span class="rozet">
        <svg viewBox="0 0 24 24" fill="#17130F" aria-hidden="true"><path d="M16.4 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.7.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.5 0-2.8.8-3.6 2.1-1.5 2.6-.4 6.5 1.1 8.7.7 1 1.6 2.2 2.7 2.2 1.1 0 1.5-.7 2.8-.7 1.3 0 1.6.7 2.8.7 1.2 0 1.9-1 2.6-2 .8-1.2 1.2-2.3 1.2-2.4-.1 0-2.2-.9-2.2-3.5zM14.2 5.9c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.7-.9 2.6 1 .1 2-.5 2.6-1.2z"/></svg>
        <span class="yazi"><span class="ust-yazi">{a.yakinda}</span><span class="alt-yazi">{a.appStore}</span></span>
      </span>
      <span class="rozet">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M4.6 2.3 14 11.7l-2.4 2.4L4 6.5V3.7c0-.6.2-1.1.6-1.4z"/><path fill="#FBBC04" d="M17.6 9.3 14 11.7l2.4 2.4 3.4-1.9c.9-.5.9-1.8 0-2.3l-2.2-1.2z"/><path fill="#EA4335" d="M4.6 2.3 16.4 9l-2.4 2.7L4.6 2.3z"/><path fill="#4285F4" d="M4.6 21.1 14 11.7l2.4 2.4L4.6 21.1z"/></svg>
        <span class="yazi"><span class="ust-yazi">{a.yakinda}</span><span class="alt-yazi">{a.googlePlay}</span></span>
      </span>
    </div>
  </header>

  <main class="sahne">
    <form id="giris-formu" class="kart" novalidate>
      <h1>{t.baslik}</h1>
      <label>
        <span class="gizli">{t.eposta}</span>
        <input type="email" name="eposta" placeholder={t.eposta} autocomplete="email" required />
      </label>
      <label>
        <span class="gizli">{t.sifre}</span>
        <input type="password" name="sifre" placeholder={t.sifre} autocomplete="current-password" required />
      </label>
      <div class="satir">
        <a class="unuttum" href="https://slooin.expo.app/sifre-sifirla">{t.sifremiUnuttum}</a>
        <button id="giris-dugmesi" type="submit">{t.dugme}</button>
      </div>
      <p id="durum" class="durum" role="status" aria-live="polite"></p>
      <p class="hesap-yok">{t.hesapYok}</p>
    </form>
  </main>

  <AltSerit dil={dil} yol="/giris" />
</Duzen>

<script>
  import '../../betik/giris.ts'
</script>

<style>
  /* Bant: marka turuncusu, ustte marka, altinda iki rozet (Swarm duzeni). */
  .bant {
    background: var(--turuncu);
    padding: 26px 16px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .marka img { display: block; height: 39px; width: auto; }
  .rozetler { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .rozet {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff; color: #17130F;
    border-radius: 10px; padding: 7px 12px 7px 10px;
    cursor: default;
  }
  .rozet svg { width: 22px; height: 22px; }
  .yazi { display: flex; flex-direction: column; line-height: 1.05; }
  .ust-yazi { font-size: 9px; letter-spacing: .04em; text-transform: uppercase; color: #6E6660; }
  .alt-yazi { font-size: 15px; font-weight: 700; letter-spacing: -.2px; }

  /* Sahne: acik zemin, ortada tek kart. */
  .sahne {
    background: #FAF7F3;
    min-height: 62vh;
    display: flex; align-items: flex-start; justify-content: center;
    padding: 56px 16px 72px;
  }
  .kart {
    width: 100%; max-width: 520px;
    background: var(--beyaz);
    border: 1px solid var(--cizgi);
    border-radius: 18px;
    padding: 28px 28px 22px;
    display: flex; flex-direction: column; gap: 14px;
    box-shadow: 0 12px 40px rgba(23, 19, 15, .06);
  }
  h1 { margin: 0 0 6px; font-size: 26px; letter-spacing: -.3px; color: var(--turuncu); font-weight: 700; }
  label { display: block; }
  .gizli { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  input {
    width: 100%; box-sizing: border-box;
    font: inherit; font-size: 16px;
    padding: 13px 14px;
    border: 1px solid var(--cizgi); border-radius: 12px;
    background: var(--beyaz); color: var(--metin);
  }
  input:focus-visible { outline: 2px solid var(--turuncu); outline-offset: 1px; border-color: transparent; }
  .satir { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 4px; }
  .unuttum { color: var(--metin); font-size: 15px; text-decoration: none; }
  .unuttum:hover { text-decoration: underline; }
  button {
    font: inherit; font-weight: 700; font-size: 16px;
    background: var(--turuncu); color: #fff;
    border: 0; border-radius: 12px;
    padding: 12px 22px; cursor: pointer;
  }
  button:hover { filter: brightness(.96); }
  button:disabled { opacity: .6; cursor: default; }
  button:focus-visible { outline: 2px solid var(--turuncu); outline-offset: 3px; }
  .durum { margin: 0; min-height: 1.4em; font-size: 14px; color: var(--ikincil); }
  .durum.hata { color: #C0392B; }
  .durum.basari { color: #1B7F3B; }
  .hesap-yok { margin: 0; padding-top: 12px; border-top: 1px solid var(--cizgi); font-size: 14px; color: var(--ikincil); }

  @media (max-width: 480px) {
    .kart { padding: 22px 18px 18px; }
    .satir { flex-direction: column-reverse; align-items: stretch; }
    button { width: 100%; }
    .unuttum { text-align: center; }
  }
</style>
