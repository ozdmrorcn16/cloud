---
import Metin from '../../duzen/Metin.astro'
import HukukiBolumler from '../../ortak/HukukiBolumler.astro'
import { dilYollari, type Dil } from '../../i18n/diller'
import { sozluk } from '../../i18n/sozlukler'
import { kosulBolumleri } from '../../hukuki/index'

// KULLANIM KOSULLARI - uygulamayla ORTAK kaynaktan, yedi dilde.
export function getStaticPaths() {
  return dilYollari()
}

const { dil } = Astro.props as { dil: Dil }
const t = sozluk(dil).kosullar
---

<Metin
  baslik={t.baslik}
  aciklama={t.aciklama}
  guncelleme={new Date(2026, 8, 7)}
  dil={dil}
  yol="/kosullar"
  hukuki
>
  <HukukiBolumler bolumler={kosulBolumleri(dil)} />
</Metin>
