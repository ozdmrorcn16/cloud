# Bu dosyayi .env olarak kopyala ve gercek degerleri oraya yaz.
# .env dosyasi asla depoya commit'lenmez.

# Borsa API kimlik bilgileri.
# Anahtari borsada olustururken:
#   - "para cekme" (withdraw) yetkisini ACMA
#   - sadece okuma + islem (spot trading) yetkisi ver
#   - IP kisitlamasi tanimla
KRIPTOBOT_API_KEY=
KRIPTOBOT_API_SECRET=

# Calisma kipi: paper | testnet | live
# Varsayilan daima paper. "live" gercek para demektir.
KRIPTOBOT_MODE=paper

# Risk limitleri
KRIPTOBOT_MAX_GUNLUK_ZARAR=0
KRIPTOBOT_MAX_POZISYON_TUTARI=0
