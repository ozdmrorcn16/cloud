# Panelin ihtiyac duydugu iki deger. Gercek degerler panel/.env icinde
# durur ve depoya GIRMEZ.
#
# Bu iki deger mobil/.env icindeki EXPO_PUBLIC_SUPABASE_URL ve
# EXPO_PUBLIC_SUPABASE_ANON_KEY ile aynidir. Anon anahtar bir sir
# degildir (istemcide zaten gomulu olur); panelde service-role anahtari
# BULUNMAZ - butun erisim moderator oturumu ve security definer
# RPC'ler uzerinden gecer (spec karar 55).
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-anahtar>
