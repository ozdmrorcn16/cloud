{
  "expo": {
    "name": "Slooin",
    "slug": "slooin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slooin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.slooin.app"
    },
    "android": {
      "package": "com.slooin.app",
      "adaptiveIcon": {
        "backgroundColor": "#E66208",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Slooin, yakınındaki mekânları ve orada olan kişileri gösterebilmek için konumunu kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Slooin, profil ve mekân fotoğrafı ekleyebilmen için galerine erişir.",
          "cameraPermission": "Slooin, mekânda fotoğraf çekebilmen için kameranı kullanır."
        }
      ],
      "expo-notifications",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "972aa05d-569b-4a5a-ab75-2b149fd8588c"
      }
    },
    "owner": "byorcun"
  }
}
